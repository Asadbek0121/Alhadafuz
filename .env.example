
# Database (Production — Neon PostgreSQL). Lokal SQLite emas.
DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"
# DIRECT_URL — Neon direct connection (pgbouncersiz, migrationlar uchun). Pgbouncer bilan ishlatilganda migratsiya uchun alohida ulanish kerak.
# DIRECT_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# Next Auth v5 (AUTH_SECRET majburiy, npx auth secret orqali yarating)
AUTH_SECRET="shadcn_secret_key_1234567890_change_me"
AUTH_URL="http://localhost:3000/api/auth"
NEXTAUTH_URL="http://localhost:3000"
# Saytning real public domeni — canonical/OG/JSON-LD URL'lar shu yerdan olinadi
NEXT_PUBLIC_APP_URL="https://www.alhadaf.uz"

# Google Auth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Telegram Bot (O'zingizning tokeningizni kiriting)
# TELEGRAM_BOT_TOKEN="sizning_bot_tokeningiz"
# COURIER_BOT_TOKEN="sizning_courier_bot_tokeningiz"

# Telegram Login (web OAuth) — /api/auth/telegram/config uchun majburiy
# TELEGRAM_BOT_TOKEN yuqorida; TELEGRAM_BOT_USERNAME — BotFather'dagi bot username (@siz)
# TELEGRAM_BOT_USERNAME="Hadaf_supportbot"

# Admin bot (admin 2FA tasdiqlash xabarlari alohida botga boradi)
# Webhook: https://<domain>/api/telegram/admin-webhook
# ADMIN_BOT_TOKEN=""
# ADMIN_BOT_USERNAME=""

# Yagona admin Telegram chat ID — barcha admin bildirishnomalari faqat shu chatga boradi
# ADMIN_CHAT_ID=""

# Click Payment (production credential'lar)
# Eslatma: Click konfiguratsiyasini admin panel > To'lov Tizimlari'dan ham sozlash mumkin
# (PaymentMethod.config JSON: service_id / merchant_id / secret_key) — u env'dan ustun turadi.
# CLICK_SERVICE_ID=""
# CLICK_MERCHANT_ID=""
# CLICK_SECRET_KEY=""

# Rate limiting (Upstash Redis)
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# WebAuthn (biometrik login)
# NEXT_PUBLIC_RP_ID=""
# NEXT_PUBLIC_ORIGIN=""

# Telegram bot username (WebAuthn/Telegram login)
# NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="HadafMarketBot"

# Yandex Maps API key (client-side, NEXT_PUBLIC_* convention)
# NEXT_PUBLIC_YANDEX_MAPS_KEY=""

# Monitoring
# RESEND_API_KEY=""
# BLOB_READ_WRITE_TOKEN=""
# GOOGLE_MAPS_API_KEY=""
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
