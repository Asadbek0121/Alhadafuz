generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String               @id @default(cuid())
  name                 String?
  email                String?              @unique
  emailVerified        DateTime?
  isVerified           Boolean              @default(false)
  username             String?              @unique
  phone                String?              @unique
  password             String?
  hashedPassword       String?
  image                String?
  role                 String               @default("USER")
  provider             String?              @default("credentials")
  uniqueId             String?              @unique
  notificationsEnabled Boolean              @default(true)
  twoFactorEnabled     Boolean              @default(false)
  isDarkMode           Boolean              @default(false)
  isDeleted            Boolean              @default(false)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  telegramId           String?              @unique
  pinHash              String?
  recoveryHash         String?
  failedAttempts       Int                  @default(0)
  lockedUntil          DateTime?
  dateOfBirth          DateTime?
  gender               String?
  botState             String?              @default("START")
  tempData             String?
  lastIp               String?
  lastLoginAt          DateTime?
  riskScore            Int                  @default(0)
  accounts             Account[]
  logs                 ActivityLog[]
  addresses            Address[]
  authenticators       Authenticator[]
  cart                 Cart?
  courierProfile       CourierProfile?
  devices              Device[]
  merchantProfile      MerchantProfile?
  receivedMessages     Message[]            @relation("ReceivedMessages")
  sentMessages         Message[]            @relation("SentMessages")
  notifications        Notification[]
  assignedOrders       Order[]              @relation("CourierOrders")
  createdOrders        Order[]              @relation("CreatedOrders")
  managedOrders        Order[]              @relation("MerchantOrders")
  orders               Order[]              @relation("CustomerOrders")
  products             Product[]            @relation("VendorProducts")
  reviews              Review[]
  sessions             Session[]
  telegramLoginTokens  TelegramLoginToken[]
  wishlist             Wishlist?
}

model CourierProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  status          String    @default("OFFLINE")
  rating          Float     @default(5.0)
  totalDeliveries Int       @default(0)
  currentLat      Float?
  currentLng      Float?
  vehicleType     String?
  balance         Float     @default(0)
  isVerified      Boolean   @default(false)
  lastOnlineAt    DateTime  @default(now())
  onDuty          Boolean   @default(false)
  courierLevel    String    @default("BRONZE")
  lastLocationAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CourierApplication {
  id          String   @id @default(cuid())
  telegramId  String   @unique
  name        String
  phone       String   @unique
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  vehicleType String?
}

model MerchantProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  storeName   String
  description String?
  logo        String?
  address     String?
  isVerified  Boolean  @default(false)
  rating      Float    @default(5.0)
  balance     Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Order {
  id                String        @id @default(cuid())
  userId            String
  courierId         String?
  merchantId        String?
  status            String        @default("CREATED")
  total             Float
  deliveryFee       Float         @default(0)
  paymentMethod     String        @default("CASH")
  paymentStatus     String        @default("PENDING")
  paymentId         String?
  paymentProvider   String?
  shippingName      String?
  shippingPhone     String?
  shippingAddress   String?
  shippingCity      String?
  shippingDistrict  String?
  districtCode      String?
  lat               Float?
  lng               Float?
  comment           String?
  couponCode        String?
  discountAmount    Float         @default(0)
  deliveryMethod    String        @default("COURIER")
  creatorId         String?
  createdVia        String?       @default("USER_APP")
  gpsLogs           String?
  deliveryPhoto     String?
  deliveryToken     String?       @unique
  tokenExpiresAt    DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  finishedAt        DateTime?
  finishedAtRaw     DateTime?
  storeId           String?
  paymentScreenshot String?
  paymentVerifiedAt DateTime?
  paymentVerifiedBy String?
  idempotencyKey    String?
  dispatchLogs      DispatchLog[]
  earnings          Earning[]
  courier           User?         @relation("CourierOrders", fields: [courierId], references: [id])
  creator           User?         @relation("CreatedOrders", fields: [creatorId], references: [id])
  merchant          User?         @relation("MerchantOrders", fields: [merchantId], references: [id])
  store             Store?        @relation(fields: [storeId], references: [id])
  user              User          @relation("CustomerOrders", fields: [userId], references: [id])
  items             OrderItem[]
  cargos            Cargo[]

  @@unique([userId, idempotencyKey])
}

model DispatchLog {
  id        String   @id @default(cuid())
  orderId   String
  courierId String
  status    String
  score     Float?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Earning {
  id        String   @id @default(cuid())
  orderId   String
  userId    String
  amount    Float
  type      String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deviceId     String?
  ipAddress    String?
  userAgent    String?
  device       Device?  @relation(fields: [deviceId], references: [id])
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Device {
  id          String    @id @default(cuid())
  userId      String
  deviceId    String    @unique
  deviceName  String
  isTrusted   Boolean   @default(false)
  lastSeen    DateTime  @updatedAt
  riskScore   Int       @default(0)
  fingerprint String?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions    Session[]

  @@index([userId])
}

model Authenticator {
  id                   String   @id @default(cuid())
  credentialID         String   @unique
  credentialPublicKey  Bytes
  counter              BigInt
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  userId               String
  createdAt            DateTime @default(now())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  title     String
  city      String
  district  String?
  street    String
  house     String?
  apartment String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TelegramLoginToken {
  token      String   @id
  status     String   @default("PENDING")
  userId     String?
  telegramId String?
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  user       User?    @relation(fields: [userId], references: [id])
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  productId       String
  vendorId        String?
  title           String
  price           Float
  quantity        Int
  image           String
  variant         String?
  fulfillmentType String?
  /// Structured variant reference (snapshot — ProductVariant keyin o'zgarsa ham
  /// order ma'lumoti buzilmaydi, lekin referens saqlanadi)
  variantId       String?
  /// O'qiladigan variant label snapshot: "Qora / XL"
  variantSnapshot String?
  /// Variant SKU snapshot
  sku             String?
  /// Variant barcode snapshot
  barcode         String?
  /// Mahsulot attributes snapshot (JSON) — sotib olingan paytdagi holat
  attributesSnapshot String?
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product @relation(fields: [productId], references: [id])
  variantRel      ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([vendorId])
  @@index([variantId])
}

// Cargo — CHINA_ORDER buyurtmalari uchun kelajakdagi kargo hisoblash modeli.
// Hozir faqat placeholder: real kargo calculator/payment hali yo'q.
// status: PENDING | CALCULATED | PAID
model Cargo {
  id        String   @id @default(cuid())
  orderId   String
  amount    Float    @default(0)
  status    String   @default("PENDING")
  weight    Float?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Product {
  id            String         @id @default(cuid())
  vendorId      String?
  title         String
  description   String
  price         Float
  oldPrice      Float?
  discount      Float?
  discountType  String?
  image         String
  images        String?
  stock         Int            @default(0)
  attributes    String?
  specs         String?
  fulfillmentType String       @default("LOCAL") // LOCAL | CHINA_ORDER
  rating        Float          @default(0)
  reviewsCount  Int            @default(0)
  category      String
  isDeleted     Boolean        @default(false)
  status        String         @default("ACTIVE")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  categoryId    String?
  mxikCode      String?
  packageCode   String?
  vatPercent    Int            @default(0)
  brand         String?
  banners       Banner[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  categoryRel   Category?      @relation("ProductCategoryOld", fields: [categoryId], references: [id])
  vendor        User?          @relation("VendorProducts", fields: [vendorId], references: [id])
  reviews       Review[]
  wishlistItems WishlistItem[]
  categories    Category[]     @relation("ProductToCategory")
  attributeValues ProductAttributeValue[]
  variants      ProductVariant[]
  bannerProducts BannerProduct[]

  @@index([title])
  @@index([category])
  @@index([price])
  @@index([createdAt])
  @@index([status])
}

model Category {
  id              String     @id @default(cuid())
  name            String
  slug            String     @unique
  image           String?
  order           Int        @default(0)
  isActive        Boolean    @default(true)
  parentId        String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  bannersAsTarget Banner[]   @relation("BannerTargetCategory")
  parent          Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children        Category[] @relation("CategoryHierarchy")
  productsOld     Product[]  @relation("ProductCategoryOld")
  banners         Banner[]   @relation("BannerToCategory")
  products        Product[]  @relation("ProductToCategory")
  attributeDefinitions CategoryAttributeDefinition[]
}

/// Kategoriya darajasidagi dynamic attribute/schema definition.
///
/// Har bir kategoriya o'z attribute to'plamini belgilaydi (masalan "Kitob" →
/// Muallif, ISBN, Nashriyot; "Kiyim" → Material, Jinsi, Mavsum). Admin shu
/// model orqali product formaga dynamic fieldlar qo'shadi.
///
/// `forVariant = true` bo'lgan definition Variant o'qi sifatida ishlatiladi
/// (masalan Rang, O'lcham) — bitta model attribute ham, variant ham bo'la oladi.
model CategoryAttributeDefinition {
  id         String        @id @default(cuid())
  categoryId String
  /// Ichki nom (slug-ish): masalan "material", "size", "color"
  name       String
  /// Default label (i18n key: `attributes.{name}` orqali override qilinadi)
  label      String
  type       AttributeType @default(TEXT)
  required   Boolean       @default(false)
  /// SELECT/MULTI_SELECT/COLOR uchun vergul bilan ajratilgan optionlar
  /// masalan: "Qizil,Ko'k,Yashil" yoki "#FF0000,#0000FF,#00FF00"
  options    String?
  /// MEASUREMENT/NUMBER uchun o'lchov birligi: "kg", "cm", "m²", "GB", "MP"
  unit       String?
  minValue   Float?
  maxValue   Float?
  /// true bo'lsa — bu definition Variant o'qi (Rang/O'lcham kombinatsiyasi)
  forVariant Boolean       @default(false)
  order      Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  category Category                  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  values   ProductAttributeValue[]

  @@index([categoryId])
}

/// Product → CategoryAttributeDefinition bo'yicha aniq qiymat.
///
/// Eski `Product.attributes` JSON bilan PARALLEL ishlaydi (transitional):
/// yangi structured format shu jadvalda saqlanadi, eski JSON o'chirilmaydi.
model ProductAttributeValue {
  id             String    @id @default(cuid())
  productId      String
  attributeDefId String
  /// JSON.stringify qiymat:
  ///   TEXT/SELECT → "Qizil"
  ///   NUMBER → 42
  ///   BOOLEAN → true
  ///   MULTI_SELECT → ["Qizil","Ko'k"]
  ///   COLOR → "#FF0000"
  ///   MEASUREMENT → {"value":12,"unit":"kg"}
  ///   DATE → "2026-01-01"
  value          String

  attributeDef CategoryAttributeDefinition @relation(fields: [attributeDefId], references: [id], onDelete: Cascade)
  product      Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeDefId])
  @@index([attributeDefId])
}

/// Product variant kombinatsiyasi. Masalan "Rang:Qora,O'lcham:XL".
///
/// `variantKey` — kombinatsiyaning canonical JSON stringi (kalitlar saralangan),
/// shuning uchun bir xil variant 2 marta yaratilmaydi (`@@unique`).
model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  /// Canonical JSON: {"O'lcham":"XL","Rang":"Qora"} (kalitlar saralangan)
  variantKey     String
  /// O'qiladigan variant label: "Qora / XL" — UI va order snapshot uchun
  variantLabel   String?
  sku            String?
  barcode        String?
  /// Variant maxsus narxi. 0 bo'lsa Product.price ishlatiladi.
  price          Float    @default(0)
  /// Chizilgan eski narx
  compareAtPrice Float?
  /// Variant maxsus stock'i. -1 bo'lsa Product.stock ishlatiladi.
  stock          Int      @default(-1)
  /// gramm (kargo hisoblash uchun CHINA_ORDER)
  weight         Float?
  /// Fulfillment override — default Product.fulfillmentType
  fulfillmentType String?
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]
  images     VariantImage[]

  @@unique([productId, variantKey])
  @@index([sku])
}

/// Variantga tegishli rasm (masalan Qora rangdagi mahsulot fotolari).
model VariantImage {
  id        String   @id @default(cuid())
  variantId String
  url       String
  order     Int      @default(0)
  isPrimary Boolean  @default(false)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
}

model Banner {
  id               String         @id @default(cuid())
  title            String
  description      String?
  image            String?
  link             String?
  position         BannerPosition @default(HOME_TOP)
  isActive         Boolean        @default(true)
  order            Int            @default(0)
  price            Float?
  oldPrice         Float?
  discount         String?
  clickCount       Int            @default(0)
  impressionCount  Int            @default(0)
  startDate        DateTime?
  endDate          DateTime?
  variant          String?
  productId        String?
  targetCategoryId String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  product          Product?       @relation(fields: [productId], references: [id])
  targetCategory   Category?      @relation("BannerTargetCategory", fields: [targetCategoryId], references: [id])
  categories       Category[]     @relation("BannerToCategory")
  events           BannerEvent[]
  bannerProducts   BannerProduct[]

  @@index([position])
  @@index([isActive])
}

/// Banner va mahsulot orasidagi M-N bog'lanish (order saqlanadi).
///
/// "Bugungi takliflar" (HOME_TOP) ko'p mahsulotli carousel sifatida ishlaydi:
/// bitta banner/campaign → ko'plab mahsulotlar. `order` mahsulotning
/// carousel ichidagi tartibini belgilaydi (sayt aynan shu tartibda chiqaradi).
model BannerProduct {
  id        String   @id @default(cuid())
  bannerId  String
  productId String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  banner  Banner  @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([bannerId, productId])
  @@index([bannerId, order])
}

/// Banner ko'rish/bosishlarining VAQT BELGILI jurnali.
///
/// Nima uchun kerak: `Banner.clickCount` / `impressionCount` — jamlanma
/// sanoqchilar, ya'ni ularda vaqt o'lchami YO'Q. Ular faqat "jami qancha"
/// deb aytadi, "qachon" deb aytmaydi, shuning uchun ular bilan vaqt bo'yicha
/// grafik chizish mumkin emas — kechagi va bugungi natijani ajratishning yo'li
/// yo'q. Har bir hodisa alohida qator sifatida yozilganda esa istalgan davr
/// bo'yicha guruhlash mumkin bo'ladi.
///
/// Sanoqchilar ATAYIN saqlanadi: bu jadval joriy etilishidan oldingi tarix
/// faqat ularda qolgan (hodisalar orqaga qarab tiklanmaydi), va sahifadagi
/// mavjud ustunlar ularga tayanadi.
model BannerEvent {
  id       String          @id @default(cuid())
  bannerId String
  type     BannerEventType

  /// Takroriy ko'rishlarni ajratish uchun brauzer sessiyasi belgisi.
  /// Yagona tashrifchilarni sanashga imkon beradi; shaxsni aniqlamaydi.
  sessionId String?

  createdAt DateTime @default(now())

  /// Banner qattiq o'chiriladi (`banner.delete`), shuning uchun `Cascade`
  /// shart — aks holda tashqi kalit o'chirishni butunlay bloklaydi.
  banner Banner @relation(fields: [bannerId], references: [id], onDelete: Cascade)

  /// Asosiy so'rov shakli — bitta banner uchun davr bo'yicha tanlash.
  @@index([bannerId, createdAt])
  /// Barcha bannerlar bo'yicha kunlik yig'ma uchun.
  @@index([type, createdAt])
  @@index([sessionId])
}

enum BannerEventType {
  IMPRESSION
  CLICK

}

model Review {
  id         String   @id @default(cuid())
  rating     Int
  comment    String?
  status     String   @default("PENDING")
  userId     String
  productId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  adminReply String?
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StoreSettings {
  id                  String   @id @default("default")
  siteName            String   @default("UzMarket")
  phone               String?
  email               String?
  address             String?
  socialLinks         String?
  telegramBotToken    String?
  telegramAdminIds    String?
  courierFeePerOrder  Float?   @default(12000)
  updatedAt           DateTime @updatedAt
  autoDispatchEnabled Boolean  @default(false)
  cardHolderName      String?
  cardNumber          String?
}

/// Header announcement marquee xabarlari.
///
/// Location (Surxondaryo) blokidan keyingi area'da ko'rinadi. Bir nechta
/// faol announcement bitta uzluksiz marquee track'ida ketma-ket chiqadi.
model Announcement {
  id              String    @id @default(cuid())
  text            String
  /// Marquee background rangi (masalan #fef3c7 / yellow). Bo'sh = default.
  backgroundColor String?
  /// Matn rangi. Bo'sh = kontrast uchun avtomatik (bg qorong'i → och matn).
  textColor       String?
  /// Ikona (emoji yoki lib'dagi nom). Masalan 🛠️
  icon            String?
  isActive        Boolean   @default(true)
  order           Int       @default(0)
  startAt         DateTime?
  endAt           DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isActive])
  @@index([order])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  details   String?
  ip        String?
  location  String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String    @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  variant   String?
  variantId String?
  fulfillmentType String?
  cart      Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantRel ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([cartId, productId, variantId])
  @@index([variantId])
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
}

model Message {
  id         String   @id @default(cuid())
  content    String
  createdAt  DateTime @default(now())
  isRead     Boolean  @default(false)
  type       String   @default("TEXT")
  senderId   String
  receiverId String
  source     String   @default("WEB")
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  title     String
  message   String
  type      String   @default("SYSTEM")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Store {
  id           String   @id @default(cuid())
  name         String
  address      String
  phone        String?
  workingHours String?
  lat          Float?
  lng          Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orders       Order[]
}

model PaymentMethod {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("MERCHANT")
  provider  String
  details   String?
  config    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentLog {
  id            String   @id @default(cuid())
  provider      String
  transactionId String?
  amount        Float?
  status        String
  requestData   String?
  responseData  String?
  ipAddress     String?
  createdAt     DateTime @default(now())
}

model ShippingZone {
  id                String   @id @default(cuid())
  name              String
  district          String?
  price             Float    @default(0)
  deliveryTime      String?
  freeFrom          Float?
  freeFromQty       Int?
  freeIfHasDiscount Boolean  @default(false)
  freeDiscountType  String   @default("ANY")
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Coupon {
  id            String   @id @default(cuid())
  code          String   @unique
  discountType  String
  discountValue Float
  minAmount     Float    @default(0)
  startDate     DateTime @default(now())
  expiryDate    DateTime
  usageLimit    Int      @default(1)
  usedCount     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum BannerPosition {
  HOME_TOP
  HOME_SIDE
  SIDEBAR
  CATEGORY_TOP
  FOOTER
}

/// Dynamic attribute qiymat turlari. `CategoryAttributeDefinition.type` da
/// ishlatiladi. TEXT — erkin matn, SELECT — bitta option, MULTI_SELECT — bir
/// nechta option, MEASUREMENT — son+o'lchov birligi (masalan "12 kg").
enum AttributeType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTI_SELECT
  COLOR
  MEASUREMENT
  DATE
}
